function simulateHealthAnalysis(age,gender,bmi,sleep,sleepBad,dietVal,exVal,risks){
    var baseLife=gender==='male'?76:81;var adj=0;
    if(bmi<16)adj-=6;else if(bmi<18.5)adj-=2;else if(bmi<=24.9)adj+=2;else if(bmi<=29.9)adj-=1;else if(bmi<=34.9)adj-=4;else adj-=7;
    if(sleep>=7&&sleep<=8)adj+=3;else if(sleep>=6&&sleep<7)adj+=1;else if(sleep>8&&sleep<=9)adj+=1;else if(sleep<4)adj-=6;else if(sleep<6)adj-=3;else if(sleep>10)adj-=2;
    adj-=sleepBad*.7;adj+=parseInt(dietVal);
    if(exVal>=5)adj+=5;else if(exVal>=3)adj+=2;else if(exVal===1)adj-=1;else adj-=4;
    var rP={smoking:-10,alcohol:-5,stress:-4,overwork:-4,nosocial:-3,caffeine:-2,insomnia2d:-8,skipmeal:-3,sleep3h:-7,longstress:-5,sedentary:-4,energydrink:-3};
    risks.forEach(function(r){adj+=(rP[r]||0);});var rc=risks.length;if(rc>=7)adj-=8;else if(rc>=5)adj-=5;else if(rc>=3)adj-=2;
    adj=Math.max(-35,Math.min(15,adj));
    var projected;if(age>=baseLife){projected=Math.round(age+Math.max(0,8+adj*.3+(Math.random()-.5)*4));}else{projected=Math.round(Math.max(age+1,baseLife+adj+(Math.random()-.5)*3));}
    return{estimated_lifespan:projected,years_remaining:Math.max(1,projected-age),risk_level_percent:Math.round(Math.max(3,Math.min(95,45-adj*2+rc*3+(Math.random()-.5)*8))),health_status:adj>=0?'Improving':'Declining',adj:adj,age:age,gender:gender,bmi:bmi,sleep:sleep,sleepBad:sleepBad,dietVal:parseInt(dietVal),exVal:parseInt(exVal),risks:risks};
}

