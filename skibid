var gc=document.getElementById('gameCanvas'),gx=gc.getContext('2d');
function gameLoop(){if(G.scr!=='game')return;updPlayer();updNPCs();updP();chkNear();render();G._raf=requestAnimationFrame(gameLoop);}
var lstStep=0;
function updPlayer(){var p=G.p,dx=0,dy=0;if(G.keys['w']||G.keys['arrowup'])dy=-p.spd;if(G.keys['s']||G.keys['arrowdown'])dy=p.spd;if(G.keys['a']||G.keys['arrowleft'])dx=-p.spd;if(G.keys['d']||G.keys['arrowright'])dx=p.spd;if(dx&&dy){dx*=.707;dy*=.707;}p.moving=!!(dx||dy);var px=p.x,py=p.y;p.x=Math.max(20,Math.min(980,p.x+dx));p.y=Math.max(110,Math.min(600,p.y+dy));G.objs.forEach(function(o){if(col4(p.x-p.sz,p.y-p.sz,p.sz*2,p.sz*2,o.x-o.w/2,o.y-o.h/2,o.w,o.h)){p.x=px;p.y=py;}});if(p.moving){var n=Date.now();if(n-lstStep>380)lstStep=n;}}
function updNPCs(){G.npcs.forEach(function(n){if(Math.random()<.008){n.tx=Math.max(80,Math.min(920,n.x+(Math.random()-.5)*60));n.ty=Math.max(120,Math.min(580,n.y+(Math.random()-.5)*60));}if(n.tx){var dx=n.tx-n.x,dy=n.ty-n.y,d=Math.hypot(dx,dy);if(d>2){n.x+=dx/d*n.spd;n.y+=dy/d*n.spd;}else{n.tx=null;n.ty=null;}}});}
function chkNear(){var p=G.p,nr=null,mn=Infinity;G.objs.forEach(function(o){var d=Math.hypot(p.x-o.x,p.y-o.y);if(d<90&&d<mn){mn=d;nr=o;}});G.near=nr;var nnpc=null,mnpc=Infinity;G.npcs.forEach(function(n){var d=Math.hypot(p.x-n.x,p.y-n.y);if(d<60&&d<mnpc){mnpc=d;nnpc=n;}});G.nearNpc=nnpc;}
function col4(x1,y1,w1,h1,x2,y2,w2,h2){return x1<x2+w2&&x1+w1>x2&&y1<y2+h2&&y1+h1>y2;}
function ltn(h,a){var r=Math.min(255,parseInt(h.slice(1,3),16)+a),g2=Math.min(255,parseInt(h.slice(3,5),16)+a),b=Math.min(255,parseInt(h.slice(5,7),16)+a);return'rgb('+r+','+g2+','+b+')';}
