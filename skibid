.fam-back{background:transparent;border:1px solid rgba(255,150,200,.25);color:rgba(255,150,200,.6);padding:7px 16px;font-family:'Courier New',monospace;font-size:10px;letter-spacing:2px;cursor:pointer;border-radius:4px;transition:all .2s}
