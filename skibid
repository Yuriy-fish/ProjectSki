var VALIDATION_RULES={age:{min:1,max:120,messages:{nan:'⚠ Vui lòng nhập số tuổi!',empty:'⚠ Tuổi không được để trống!',tooLow:function(v){return v<=0?'⚠ Tuổi không thể âm hoặc bằng 0!':'⚠ Tuổi tối thiểu là 1!';},tooHigh:function(v){return v>200?'⚠ '+v+' tuổi?! Không ai sống lâu đến vậy 😅':'⚠ Tuổi tối đa là 120!';},ok:function(v){return v>=100?'✓ Hợp lệ (tuổi thọ đáng nể!)':'✓ Hợp lệ';}}},bmi:{min:10,max:80,messages:{nan:'⚠ Vui lòng nhập chỉ số BMI!',empty:'⚠ BMI không được để trống!',tooLow:function(){return'⚠ BMI tối thiểu hợp lệ là 10!';},tooHigh:function(){return'⚠ BMI tối đa ghi nhận là ~80!';},ok:function(v){return v<18.5?'✓ Hợp lệ (thiếu cân)':v<=24.9?'✓ Hợp lệ (bình thường 👍)':v<=29.9?'✓ Hợp lệ (thừa cân)':'✓ Hợp lệ (béo phì)';}}},sleep:{min:0,max:24,messages:{nan:'⚠ Vui lòng nhập số giờ ngủ!',empty:'⚠ Giờ ngủ không được để trống!',tooLow:function(){return'⚠ Giờ ngủ không thể là số âm!';},tooHigh:function(){return'⚠ Một ngày chỉ có 24 tiếng thôi!';},ok:function(v){return v<6?'✓ Hợp lệ (⚠ thiếu ngủ nghiêm trọng)':v<=8?'✓ Hợp lệ (giờ ngủ tốt 👍)':'✓ Hợp lệ (ngủ nhiều)';}}},sleep_bad:{min:0,max:7,messages:{nan:'⚠ Vui lòng nhập số ngày!',empty:'⚠ Không được để trống!',tooLow:function(){return'⚠ Số ngày không thể âm!';},tooHigh:function(){return'⚠ Một tuần chỉ có 7 ngày thôi!';},ok:function(v){return v===0?'✓ Hợp lệ (tuyệt vời!)':'✓ Hợp lệ';}}}};
var fieldValidity={age:true,bmi:true,sleep:true,sleep_bad:true};
function validateField(input,key){var rules=VALIDATION_RULES[key];if(!rules)return true;var raw=input.value.trim();var errEl=document.getElementById('err_'+key),okEl=document.getElementById('ok_'+key);var msg='',valid=false;if(raw===''){msg=rules.messages.empty;}else{var v=parseFloat(raw);if(isNaN(v))msg=rules.messages.nan;else if(v<rules.min)msg=typeof rules.messages.tooLow==='function'?rules.messages.tooLow(v):rules.messages.tooLow;else if(v>rules.max)msg=typeof rules.messages.tooHigh==='function'?rules.messages.tooHigh(v):rules.messages.tooHigh;else valid=true;}fieldValidity[key]=valid;if(!valid){input.classList.add('invalid');if(errEl){errEl.textContent=msg;errEl.classList.add('show');}if(okEl)okEl.classList.remove('show');}else{input.classList.remove('invalid');if(errEl)errEl.classList.remove('show');if(okEl){var v2=parseFloat(raw);okEl.textContent=typeof rules.messages.ok==='function'?rules.messages.ok(v2):'✓ Hợp lệ';okEl.classList.add('show');}}return valid;}
function validateAllFields(){var a=validateField(document.getElementById('ai_age'),'age'),b=validateField(document.getElementById('ai_bmi'),'bmi'),c=validateField(document.getElementById('ai_sleep'),'sleep'),d=validateField(document.getElementById('ai_sleep_bad'),'sleep_bad');if(!a||!b||!c||!d){var first=!a?document.getElementById('ai_age'):!b?document.getElementById('ai_bmi'):!c?document.getElementById('ai_sleep'):document.getElementById('ai_sleep_bad');first.focus();SFX.warn();return false;}return true;}

