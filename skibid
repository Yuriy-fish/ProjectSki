.fam-inp{width:100%;background:#0a0614;border:1px solid rgba(255,150,200,.18);color:#e0c0d8;font-family:'Courier New',monospace;font-size:11px;padding:7px 10px;border-radius:4px;outline:none;margin-bottom:7px;transition:border-color .2s}
.fam-inp:focus{border-color:rgba(255,150,200,.5)}
.fam-inp-row{display:flex;gap:7px;margin-bottom:7px}
.fam-inp-row .fam-inp{margin-bottom:0}
.fam-inp-label{color:rgba(255,150,200,.35);font-size:9px;letter-spacing:1px;margin-bottom:4px;display:block}
.fam-save-btn{background:linear-gradient(135deg,#5a1a40,#ff80b0);border:none;color:#fff;padding:8px 18px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;cursor:pointer;border-radius:4px;letter-spacing:2px;transition:all .2s}
.fam-save-btn:hover{filter:brightness(1.1);transform:translateY(-1px)}
/* RIGHT: message preview */
.fam-right{width:280px;flex-shrink:0;border-left:1px solid rgba(255,150,200,.1);display:flex;flex-direction:column;overflow:hidden}
.fam-right-top{padding:12px 14px;border-bottom:1px solid rgba(255,150,200,.08)}
.fam-right-top h3{color:rgba(255,150,200,.6);font-size:10px;letter-spacing:3px}
.fam-msg-preview{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px}
.fam-msg-preview::-webkit-scrollbar{width:3px}
.msg-bubble-out{background:linear-gradient(135deg,rgba(90,26,64,.8),rgba(255,128,176,.1));border:1px solid rgba(255,150,200,.2);border-radius:12px 12px 3px 12px;padding:10px 13px;font-size:12px;color:#ffe0f0;line-height:1.6;align-self:flex-end;max-width:90%}
.msg-bubble-in{background:rgba(20,10,30,.9);border:1px solid rgba(255,150,200,.1);border-radius:12px 12px 12px 3px;padding:10px 13px;font-size:12px;color:rgba(200,180,210,.7);line-height:1.6;align-self:flex-start;max-width:90%}
.msg-meta{font-size:9px;color:rgba(255,150,200,.3);letter-spacing:1px;margin-bottom:4px}
.fam-quick-msgs{padding:10px 12px;border-top:1px solid rgba(255,150,200,.08)}
.fam-quick-msgs p{color:rgba(255,150,200,.4);font-size:8px;letter-spacing:2px;margin-bottom:7px}
.fam-quick-msg-btn{width:100%;background:rgba(255,150,200,.07);border:1px solid rgba(255,150,200,.15);color:rgba(255,180,210,.7);padding:7px 12px;font-family:'Inter',sans-serif;font-size:11px;cursor:pointer;border-radius:6px;margin-bottom:5px;text-align:left;transition:all .2s;line-height:1.4}
.fam-quick-msg-btn:hover{background:rgba(255,150,200,.15);color:#ffb0d8;border-color:rgba(255,150,200,.4);transform:translateX(2px)}
.fam-quick-msg-btn span{display:block;font-size:9px;color:rgba(255,150,200,.35);margin-top:2px}
/* Toast notification */
.toast{position:fixed;bottom:30px;right:30px;background:rgba(0,30,24,.97);border:1px solid #00d4b4;border-radius:8px;padding:12px 18px;color:#00d4b4;font-size:12px;font-family:'Courier New',monospace;letter-spacing:1px;z-index:9999;animation:toastIn .3s ease;pointer-events:none;max-width:280px}
.toast.pink{border-color:#ff80b0;color:#ff80b0;background:rgba(30,5,20,.97)}
.toast.red{border-color:#ff4444;color:#ff4444;background:rgba(30,0,0,.97)}
@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
/* Urgent reminder overlay for game */
.game-reminder{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:rgba(80,0,40,.95);border:1px solid rgba(255,120,180,.5);border-radius:8px;padding:8px 18px;color:#ffb0d8;font-size:11px;letter-spacing:1px;z-index:50;animation:tf 2s infinite;cursor:pointer;max-width:380px;text-align:center}
</style>
