var bodyRaf=null;
function drawBodyDiagram(r,age){
    var c=document.getElementById('bodyCanvas');if(!c)return;
    cancelAnimationFrame(bodyRaf);
    var _age=age||(AI_RESULT?AI_RESULT.age:30)||30;
    var sc=_age<=5?.42:_age<=10?.58:_age<=14?.74:_age<=17?.87:_age<=40?1:_age<=60?.96:_age<=75?.90:.82;
    var hunch=_age>=70?.10:_age>=60?.05:0;
    var status=r?r.health_status:'Improving',lifespan=r?r.estimated_lifespan:80;
    function draw(){if(G.scr!=='ai')return;
        var W=c.width=160,H=c.height=250,x=c.getContext('2d'),t=Date.now()/1000;
        x.clearRect(0,0,W,H);
        x.strokeStyle='rgba(0,212,180,.04)';x.lineWidth=1;for(var i=0;i<W;i+=16){x.beginPath();x.moveTo(i,0);x.lineTo(i,H);x.stroke();}for(var j=0;j<H;j+=16){x.beginPath();x.moveTo(0,j);x.lineTo(W,j);x.stroke();}
        var sy=(t*50)%H;x.strokeStyle='rgba(0,212,180,.2)';x.lineWidth=1;x.beginPath();x.moveTo(0,sy);x.lineTo(W,sy);x.stroke();
        var goodC=status==='Improving'?'#00d4b4':'#ff4444';var pulse=.88+Math.sin(t*(status==='Improving'?1.2:2.5))*.12;
        var cxb=80,baseY=28;
        var rad=x.createRadialGradient(cxb,baseY+70*sc,4,cxb,baseY+70*sc,55*pulse*sc);rad.addColorStop(0,status==='Improving'?'rgba(0,212,180,.18)':'rgba(255,60,60,.18)');rad.addColorStop(1,'transparent');x.fillStyle=rad;x.beginPath();x.arc(cxb,baseY+70*sc,55*pulse*sc,0,Math.PI*2);x.fill();
        x.shadowColor=goodC;x.shadowBlur=8;x.strokeStyle=goodC;x.lineWidth=1.5;x.fillStyle='rgba(0,10,18,.9)';
        // age tag
        x.shadowBlur=0;var ageTag=_age<=12?'👶 Trẻ em':_age<=17?'🧒 Thiếu niên':_age<=35?'💪 Thanh niên':_age<=60?'🧑 Trung niên':_age<=75?'👴 Cao tuổi':'🧓 Lão niên';
        x.font='bold 8px Inter,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillStyle='rgba(0,212,180,.45)';x.fillText(ageTag,cxb,baseY-5);
        x.shadowColor=goodC;x.shadowBlur=7;
        var headR=13*sc;
        x.fillStyle='rgba(0,10,18,.9)';x.strokeStyle=goodC;x.beginPath();x.arc(cxb,baseY+headR,headR,0,Math.PI*2);x.fill();x.stroke();
        x.fillStyle=goodC;x.shadowBlur=3;x.beginPath();x.arc(cxb-4*sc,baseY+headR-3*sc,2*sc,0,Math.PI*2);x.fill();x.beginPath();x.arc(cxb+4*sc,baseY+headR-3*sc,2*sc,0,Math.PI*2);x.fill();
        x.save();x.translate(cxb,baseY+headR*2+1);x.rotate(hunch);
        var nH=7*sc,tH=40*sc,tW=32*sc;
        x.fillStyle='rgba(0,10,18,.9)';x.strokeStyle=goodC;x.fillRect(-4*sc,0,8*sc,nH);x.strokeRect(-4*sc,0,8*sc,nH);
        x.beginPath();x.roundRect(-tW/2,nH,tW,tH,2);x.fill();x.stroke();
        var aS=status==='Declining'?0:Math.sin(t*2)*5*sc;
        x.beginPath();x.moveTo(-tW/2,nH+3);x.lineTo(-tW/2-10*sc,nH+20*sc+aS);x.stroke();x.beginPath();x.moveTo(tW/2,nH+3);x.lineTo(tW/2+10*sc,nH+20*sc-aS);x.stroke();
        x.fillStyle=goodC;x.shadowBlur=2;x.beginPath();x.arc(-tW/2-10*sc,nH+22*sc+aS,3*sc,0,Math.PI*2);x.fill();x.beginPath();x.arc(tW/2+10*sc,nH+22*sc-aS,3*sc,0,Math.PI*2);x.fill();
        var lS=Math.sin(t*2)*4*sc;x.strokeStyle=goodC;x.lineWidth=2*sc;var lSt=nH+tH;
        x.beginPath();x.moveTo(-7*sc,lSt);x.lineTo(-9*sc+lS,lSt+33*sc);x.stroke();x.beginPath();x.moveTo(7*sc,lSt);x.lineTo(9*sc-lS,lSt+33*sc);x.stroke();
        x.fillStyle=goodC;x.beginPath();x.ellipse(-9*sc+lS,lSt+35*sc,5*sc,2*sc,0,0,Math.PI*2);x.fill();x.beginPath();x.ellipse(9*sc-lS,lSt+35*sc,5*sc,2*sc,0,0,Math.PI*2);x.fill();
        x.restore();x.shadowBlur=0;
        var liftedY=baseY+headR*2+7*sc+40*sc+33*sc+26;var lC2=lifespan<65?'#ff4444':lifespan<75?'#ffd700':'#00d4b4';
        x.font='bold 14px Courier New';x.textAlign='center';x.textBaseline='middle';x.fillStyle=lC2;x.fillText(lifespan?lifespan+'t':'—',cxb,liftedY);
        x.fillStyle='rgba(255,255,255,.18)';x.font='7px Inter';x.fillText('TUỔI THỌ',cxb,liftedY+12);
        x.fillStyle='rgba(0,212,180,.3)';x.font='9px Inter';x.fillText(_age+' tuổi',cxb,liftedY+23);
        bodyRaf=requestAnimationFrame(draw);}draw();}

