<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<title>If You Fall</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',system-ui,sans-serif;background:#141820;color:#d0d8e8;overflow:hidden;width:100vw;height:100vh}
.screen{position:absolute;top:0;left:0;width:100%;height:100%;display:none}
.screen.active{display:flex}

/* MENU */
#mainMenu{background:linear-gradient(135deg,#1a1f2e,#1e2538,#1a2030)}
#bgCanvas{position:absolute;inset:0;width:100%;height:100%}
.menu-layout{position:relative;z-index:5;display:flex;width:100%;height:100%}
.menu-left{flex:1;position:relative;overflow:hidden}
#sceneCanvas{position:absolute;inset:0;width:100%;height:100%}
.title-block{position:absolute;bottom:70px;left:0;right:0;text-align:center;background:linear-gradient(to top,rgba(12,16,28,.95),rgba(12,16,28,.6) 60%,transparent);padding:50px 20px 32px}
.title-block h1{font-family:'Playfair Display',serif;font-size:5.5em;font-weight:900;letter-spacing:12px;color:#e8edf8;text-shadow:0 0 40px rgba(140,170,220,.3)}
.title-block h1 span{color:#e88a9a}
.title-block p{color:rgba(160,180,210,.45);font-size:10px;letter-spacing:6px;text-transform:uppercase;margin-top:14px}
.menu-right{width:320px;flex-shrink:0;background:rgba(22,28,40,.92);backdrop-filter:blur(20px);border-left:1px solid rgba(120,160,220,.1);display:flex;flex-direction:column;box-shadow:-4px 0 30px rgba(0,0,0,.3)}
.menu-brand{padding:32px 28px 22px;border-bottom:1px solid rgba(120,160,220,.08)}
.menu-brand .brand-name{color:rgba(122,173,255,.85);font-size:12px;letter-spacing:5px;font-weight:bold}
.menu-brand .brand-sub{color:rgba(160,180,210,.3);font-size:9px;letter-spacing:3px;margin-top:5px}
.menu-nav{flex:1;padding:22px 14px;display:flex;flex-direction:column;gap:8px;justify-content:center}
.mbtn{background:rgba(30,38,55,.7);border:1px solid rgba(120,160,220,.08);border-left:3px solid transparent;border-radius:12px;color:rgba(180,195,220,.7);padding:16px 22px;font-family:'Inter',system-ui,sans-serif;font-size:14px;cursor:pointer;text-align:left;transition:all .25s;display:flex;align-items:center;gap:12px;letter-spacing:1px}
.mbtn:hover{border-left-color:#7aadff;color:#e0e8f4;background:rgba(122,173,255,.08);transform:translateX(4px)}
.mbtn.pri{border-left-color:rgba(122,173,255,.5);color:#c0d4ff;background:linear-gradient(135deg,rgba(122,173,255,.12),rgba(122,173,255,.04));font-weight:bold;font-size:15px;padding:18px 22px}
.mbtn.ai-btn{border-left-color:rgba(0,200,170,.4);color:rgba(0,220,190,.8)}
.mbtn.ai-btn:hover{border-left-color:#00dcc0;color:#fff;background:rgba(0,220,190,.08);transform:translateX(4px)}
.mbtn.fam-btn{border-left-color:rgba(255,150,200,.4);color:rgba(255,170,210,.8)}
.mbtn.fam-btn:hover{border-left-color:#ffb0d0;color:#fff;background:rgba(255,150,200,.08);transform:translateX(4px)}
.mbtn.sett-btn-m{border-left-color:rgba(160,150,255,.3);color:rgba(160,150,255,.7)}
.mbtn .ico{font-size:18px;width:24px;text-align:center;flex-shrink:0}
.mdiv{height:1px;background:linear-gradient(90deg,transparent,rgba(120,160,220,.08),transparent);margin:6px 16px}
.menu-foot{padding:18px 28px;border-top:1px solid rgba(120,160,220,.06)}
.menu-foot p{color:rgba(160,180,210,.2);font-size:9px;letter-spacing:2px}

/* STORY */
#storyScreen{background:#000;align-items:center;justify-content:center;flex-direction:column}
.story-box{position:relative;z-index:5;max-width:680px;width:90%;background:rgba(10,14,24,.92);border:1px solid rgba(122,173,255,.15);border-radius:8px;padding:36px 40px;animation:fadeIn .5s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.story-chapter{color:rgba(122,173,255,.6);font-size:9px;letter-spacing:4px;margin-bottom:14px}
.story-title{font-size:22px;font-weight:900;color:#fff;letter-spacing:3px;margin-bottom:20px;line-height:1.3}
.story-title span{color:#ff4444}
.story-text{color:rgba(220,200,200,.82);font-size:12.5px;line-height:2;margin-bottom:22px}
.story-goal{background:rgba(255,200,0,.07);border:1px solid rgba(255,200,0,.25);border-radius:3px;padding:14px 18px;margin-bottom:22px}
.story-goal .goal-lbl{color:rgba(255,200,0,.6);font-size:8px;letter-spacing:3px;margin-bottom:6px}
.story-goal .goal-val{color:#ffd700;font-size:20px;font-weight:900;letter-spacing:2px}
.story-goal .goal-sub{color:rgba(255,200,0,.4);font-size:9px;margin-top:4px}
.story-controls{display:flex;gap:10px;margin-top:4px}
.story-btn{background:linear-gradient(135deg,rgba(122,173,255,.2),rgba(122,173,255,.1));border:1px solid rgba(122,173,255,.3);color:#c0d4ff;padding:11px 24px;font-family:'Inter',sans-serif;font-size:11px;font-weight:bold;cursor:pointer;border-radius:6px;letter-spacing:2px;transition:all .2s;flex:1}
.story-btn:hover{background:linear-gradient(135deg,rgba(122,173,255,.3),rgba(122,173,255,.15));transform:translateY(-1px)}
.story-btn.sec{background:transparent;border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.4)}
.story-scroll{max-height:52vh;overflow-y:auto;padding-right:6px}
.story-scroll::-webkit-scrollbar{width:3px}
.story-scroll::-webkit-scrollbar-thumb{background:rgba(122,173,255,.2)}

/* GAME */
#gameScreen{align-items:center;justify-content:center;background:#000}
#gameCanvas{display:block}
.g-back{position:absolute;top:18px;right:18px;z-index:20;background:rgba(10,14,24,.9);border:1px solid rgba(122,173,255,.2);color:rgba(122,173,255,.8);padding:7px 15px;font-family:'Inter',sans-serif;font-size:10px;letter-spacing:2px;cursor:pointer;border-radius:6px;transition:all .2s}
.hud{position:absolute;top:18px;left:18px;width:260px}
.hud-box{background:rgba(10,14,24,.92);border:1px solid rgba(122,173,255,.12);border-radius:6px;padding:14px;margin-bottom:6px}
.hw{color:rgba(122,173,255,.7);font-size:9px;letter-spacing:3px;margin-bottom:11px;border-bottom:1px solid rgba(122,173,255,.1);padding-bottom:6px;display:flex;justify-content:space-between;align-items:center}
.money-hud{background:rgba(10,14,24,.92);border:1px solid rgba(255,200,0,.2);border-radius:6px;padding:12px 14px;margin-bottom:6px}
.money-lbl{color:rgba(255,200,0,.5);font-size:8px;letter-spacing:3px}
.money-val{color:#ffd700;font-size:20px;font-weight:900}
.money-goal{color:rgba(255,200,0,.35);font-size:8px;margin-top:2px}
.money-prog{height:4px;background:#1a1400;border-radius:2px;margin-top:7px;overflow:hidden}
.money-fill{height:100%;background:linear-gradient(90deg,#b8860b,#ffd700);border-radius:2px;transition:width .5s}
.hs{margin:8px 0}.hl{color:rgba(160,180,210,.6);font-size:8px;letter-spacing:2px;margin-bottom:3px}
.bw{height:5px;background:#080810;border-radius:2px;overflow:hidden}
.bf{height:100%;border-radius:2px;transition:width .5s}
.be{background:linear-gradient(90deg,#00b4d8,#0077b6)}
.bs{background:linear-gradient(90deg,#e63946,#c1121f)}
.bv{float:right;font-size:8px;color:rgba(180,195,220,.6);margin-top:-10px}
.hi{margin-top:9px;padding-top:8px;border-top:1px solid rgba(122,173,255,.08)}
.hi p{font-size:9px;color:rgba(160,180,210,.5);margin:3px 0}
.hi span{color:rgba(200,210,230,.7)}
.hwarn{background:rgba(255,60,60,.12);border:1px solid rgba(255,60,60,.45);border-radius:2px;padding:7px 10px;font-size:9px;color:#ff5050;letter-spacing:1px;display:none;animation:wp 1s infinite;margin-top:4px}
.hwarn.on{display:block}
@keyframes wp{0%,100%{opacity:1}50%{opacity:.7}}
.itip{position:absolute;bottom:40px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.92);border:1px solid #ffd700;color:#ffd700;padding:12px 24px;font-size:14px;border-radius:4px;display:none;letter-spacing:1.5px;white-space:nowrap;font-weight:bold}
.itip.on{display:block;animation:tf 1.8s infinite}
@keyframes tf{0%,100%{opacity:1}50%{opacity:.65}}
.chint{position:absolute;bottom:14px;right:14px;font-size:8px;color:#1a1a2a;letter-spacing:1px}
.vig{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .4s}
.vig.vh{background:radial-gradient(ellipse,transparent 18%,rgba(120,0,0,.65) 100%);opacity:1}
.vig.vc{background:radial-gradient(ellipse,transparent 8%,rgba(160,0,0,.88) 100%);opacity:1;animation:cs .4s infinite}
@keyframes cs{0%,100%{transform:none}33%{transform:translate(-3px,1px)}66%{transform:translate(3px,-1px)}}
.money-pop{position:absolute;font-weight:900;font-size:18px;color:#ffd700;text-shadow:0 0 12px rgba(255,215,0,.8);pointer-events:none;animation:moneyPop 1.2s ease-out forwards}
@keyframes moneyPop{0%{opacity:1;transform:translateY(0) scale(1.2)}100%{opacity:0;transform:translateY(-55px) scale(.9)}}
.dmg-pop{position:absolute;font-weight:900;font-size:16px;color:#ff4444;text-shadow:0 0 12px rgba(255,0,0,.8);pointer-events:none;animation:moneyPop 1.2s ease-out forwards}
.event-overlay{position:absolute;inset:0;background:rgba(0,0,0,.93);display:none;align-items:center;justify-content:center;z-index:500;backdrop-filter:blur(6px)}
.event-overlay.on{display:flex}
.event-box{max-width:560px;width:92%;background:linear-gradient(145deg,#0a0005,#060012);border:2px solid rgba(255,40,40,.55);border-radius:4px;padding:30px 34px;animation:evIn .6s ease}
@keyframes evIn{0%{transform:scale(.88) translateY(-30px);opacity:0}60%{transform:scale(1.02)}100%{transform:scale(1);opacity:1}}
.ev-chapter{color:rgba(255,80,80,.6);font-size:8px;letter-spacing:4px;margin-bottom:10px}
.ev-title{font-size:20px;font-weight:900;color:#fff;margin-bottom:16px;line-height:1.3}
.ev-text{color:rgba(220,200,200,.82);font-size:12px;line-height:2;margin-bottom:18px;white-space:pre-line}
.ev-impact{background:rgba(255,30,30,.12);border:1px solid rgba(255,60,60,.5);border-radius:3px;padding:14px 18px;margin-bottom:20px;text-align:center}
.ev-impact .ei-lbl{color:rgba(255,100,100,.6);font-size:8px;letter-spacing:3px;margin-bottom:5px}
.ev-impact .ei-val{color:#ff4444;font-size:24px;font-weight:900}
.ev-impact .ei-new{color:rgba(255,200,0,.75);font-size:10px;margin-top:5px}
.ev-confirm{width:100%;padding:13px;background:linear-gradient(135deg,#7a0000,#e63946);border:none;color:#fff;font-family:'Courier New',monospace;font-size:12px;font-weight:bold;cursor:pointer;border-radius:2px;letter-spacing:2px;transition:all .2s}

/* MODAL */
.movl{position:absolute;inset:0;background:rgba(0,0,0,.88);display:none;align-items:center;justify-content:center;z-index:1000;backdrop-filter:blur(3px)}
.movl.on{display:flex}
.mbox{background:linear-gradient(155deg,#070710,#0e0616);border:1px solid #241424;border-radius:3px;padding:26px;max-width:600px;width:90%;max-height:88vh;overflow-y:auto;animation:ms .2s ease}
@keyframes ms{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}
.mbox h2{color:#ff4444;margin-bottom:13px;font-size:22px;border-bottom:1px solid #241424;padding-bottom:9px;font-weight:bold}
.mbox p{color:#b0b0c0;margin:8px 0;line-height:1.75;font-size:13px}
.cg{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
.cb{background:#080812;border:1px solid #222240;color:#b0b0c0;padding:12px 16px;font-family:'Courier New',monospace;font-size:13px;cursor:pointer;transition:all .2s;flex:1;min-width:160px;border-radius:4px;line-height:1.5;font-weight:bold}
.cb:hover{border-color:#ffd700;background:rgba(255,215,0,.06);color:#fff;transform:translateY(-2px)}
.cb .cb-tag{display:block;font-size:10px;margin-top:5px;letter-spacing:1px;font-weight:normal}
.cb .cb-good{color:#4ecdc4}.cb .cb-bad{color:#e63946}.cb .cb-cost{color:#ff8800}
.bok{background:#e63946;border:none;color:#fff;padding:10px 22px;font-family:'Courier New',monospace;font-size:13px;font-weight:bold;cursor:pointer;border-radius:4px;margin-top:10px;letter-spacing:1.5px;transition:all .2s}
.bok:hover{background:#c1121f;transform:translateY(-2px)}
.bok.gold{background:linear-gradient(135deg,#b8860b,#ffd700);color:#000}
.bok.teal{background:linear-gradient(135deg,#007a6a,#00d4b4);color:#000}
.bok.pink{background:linear-gradient(135deg,#7a3060,#ff80b0);color:#fff}
.ibox{background:rgba(0,212,180,.05);border-left:2px solid #00d4b4;padding:9px 12px;margin:8px 0;border-radius:1px;font-size:11px;color:#7aa09a}
.wbox{background:rgba(230,57,70,.07);border-left:2px solid #e63946;padding:9px 12px;margin:8px 0;border-radius:1px;font-size:11px;color:#b07070}
.gbox{background:rgba(255,215,0,.05);border-left:2px solid #ffd700;padding:9px 12px;margin:8px 0;border-radius:1px;font-size:11px;color:#c8a800}
.pbox{background:rgba(255,150,200,.05);border-left:2px solid #ff90c0;padding:9px 12px;margin:8px 0;border-radius:1px;font-size:11px;color:#c07090}
.mbox::-webkit-scrollbar{width:4px}.mbox::-webkit-scrollbar-thumb{background:rgba(122,173,255,.2)}

/* SETTINGS */
#settingsScreen{background:#000;align-items:center;justify-content:center}
.sett-panel{background:rgba(4,4,14,.98);border:1px solid rgba(140,120,255,.2);border-radius:4px;padding:36px 44px;width:560px;max-width:94vw;animation:fadeIn .4s ease}
.sett-h{color:#9090ff;font-size:17px;font-weight:900;letter-spacing:4px;margin-bottom:5px}
.sett-sub{color:rgba(255,255,255,.2);font-size:9px;letter-spacing:3px;margin-bottom:26px;padding-bottom:14px;border-bottom:1px solid rgba(140,120,255,.1)}
.sett-sec{margin-bottom:20px}.sett-sec-t{color:rgba(140,120,255,.5);font-size:8px;letter-spacing:3px;margin-bottom:12px}
.sett-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.sett-lbl{color:rgba(200,180,200,.7);font-size:11px;letter-spacing:1px}
.sett-rv{display:flex;align-items:center;gap:10px}
.sett-val{color:#ffd700;font-size:11px;width:30px;text-align:right}
input[type=range]{-webkit-appearance:none;width:130px;height:3px;background:#1a1a2a;border-radius:2px;outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;border-radius:50%;background:#9090ff;cursor:pointer}
.diff-grp{display:flex;gap:8px}
.diff-btn{background:#080812;border:1px solid #222;color:rgba(200,180,200,.5);padding:8px 14px;font-family:'Courier New',monospace;font-size:10px;cursor:pointer;border-radius:2px;transition:all .2s;letter-spacing:1px}
.diff-btn.active{border-color:#9090ff;color:#b0b0ff;background:rgba(140,120,255,.08)}
.tog-wrap{position:relative;width:40px;height:20px;cursor:pointer;display:inline-block}
.tog-wrap input{opacity:0;width:0;height:0;position:absolute}
.tog-sl{position:absolute;inset:0;background:#1a1a2a;border-radius:10px;transition:.3s}
.tog-sl:before{content:'';position:absolute;width:14px;height:14px;left:3px;bottom:3px;background:#444;border-radius:50%;transition:.3s}
.tog-wrap input:checked+.tog-sl{background:rgba(140,120,255,.3)}
.tog-wrap input:checked+.tog-sl:before{transform:translateX(20px);background:#9090ff}
.key-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.key-row{display:flex;align-items:center;gap:8px}
.key-kbd{background:#0a0a1a;border:1px solid #2a2a4a;color:#6a6a9a;font-size:9px;padding:3px 7px;border-radius:2px;font-family:'Courier New',monospace}
.key-lbl{color:rgba(180,160,200,.5);font-size:9px}
.sett-acts{display:flex;gap:10px;margin-top:22px;padding-top:16px;border-top:1px solid rgba(140,120,255,.1)}
.sa-btn{flex:1;padding:11px;font-family:'Courier New',monospace;font-size:11px;cursor:pointer;border-radius:2px;letter-spacing:2px;transition:all .2s;border:none}
.sa-btn.pri{background:#9090ff;color:#000}
.sa-btn.sec{background:transparent;border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.35)}

/* AI SCREEN */
#aiScreen{background:#000;align-items:stretch;flex-direction:row}
.ai-left{width:280px;flex-shrink:0;background:rgba(0,5,12,.98);border-right:1px solid rgba(0,212,180,.15);display:flex;flex-direction:column;overflow:hidden}
.ai-field input.invalid,.ai-field select.invalid{border-color:#ff4444!important}
.field-error{color:#ff5555;font-size:9px;letter-spacing:1px;margin-top:3px;display:none}
.field-error.show{display:block}
.field-ok{color:#00d4b4;font-size:9px;letter-spacing:1px;margin-top:3px;display:none}
.field-ok.show{display:block}
.ai-resize-handle{width:5px;flex-shrink:0;background:rgba(0,212,180,.06);cursor:col-resize;display:flex;align-items:center;justify-content:center;transition:background .2s;user-select:none}
.ai-resize-handle:hover,.ai-resize-handle.dragging{background:rgba(0,212,180,.25)}
.ai-resize-handle::after{content:'';display:block;width:2px;height:40px;background:rgba(0,212,180,.4);border-radius:2px}
.ai-header{padding:14px 14px 10px;border-bottom:1px solid rgba(0,212,180,.1)}
.ai-header .ai-tag{color:rgba(0,212,180,.5);font-size:8px;letter-spacing:4px;margin-bottom:4px}
.ai-header h2{color:#00d4b4;font-size:13px;letter-spacing:2px;font-weight:900}
.ai-header p{color:rgba(255,255,255,.2);font-size:9px;margin-top:3px;line-height:1.5}
.ai-form-area{flex:1;overflow-y:auto;padding:10px}
.ai-form-area::-webkit-scrollbar{width:3px}
.ai-form-area::-webkit-scrollbar-thumb{background:rgba(0,212,180,.2)}
.ai-section{margin-bottom:12px}
.ai-section-title{color:rgba(0,212,180,.45);font-size:8px;letter-spacing:3px;margin-bottom:7px;padding-bottom:4px;border-bottom:1px solid rgba(0,212,180,.07)}
.ai-field{margin-bottom:7px}
.ai-field label{display:block;color:rgba(255,255,255,.35);font-size:9px;letter-spacing:1px;margin-bottom:3px}
.ai-field input,.ai-field select,.ai-field textarea{width:100%;background:#020a0e;border:1px solid rgba(0,212,180,.15);color:#c0e0d8;font-family:'Courier New',monospace;font-size:11px;padding:5px 7px;border-radius:2px;outline:none;transition:border-color .2s}
.ai-field input:focus,.ai-field select:focus,.ai-field textarea:focus{border-color:rgba(0,212,180,.5)}
.ai-field textarea{resize:none;height:48px;line-height:1.5}
.ai-field select option{background:#020a0e}
.ai-check-group{display:flex;flex-wrap:wrap;gap:4px}
.ai-check{background:#020a0e;border:1px solid rgba(0,212,180,.12);color:rgba(200,220,215,.5);padding:3px 7px;font-family:'Courier New',monospace;font-size:9px;cursor:pointer;border-radius:2px;transition:all .2s;letter-spacing:1px}
.ai-check.on{border-color:#00d4b4;color:#00d4b4;background:rgba(0,212,180,.07)}
.ai-footer{padding:8px 14px;border-top:1px solid rgba(0,212,180,.1)}
.ai-submit{width:100%;background:linear-gradient(135deg,#004a42,#00d4b4);border:none;color:#000;padding:9px;font-family:'Courier New',monospace;font-size:11px;font-weight:bold;cursor:pointer;border-radius:2px;letter-spacing:2px;transition:all .2s}
.ai-submit:hover{filter:brightness(1.1);transform:translateY(-1px)}
.ai-submit:disabled{opacity:.4;cursor:not-allowed;transform:none}
.ai-disclaimer{color:rgba(255,255,255,.1);font-size:8px;text-align:center;padding:6px;border-top:1px solid rgba(0,212,180,.05)}

/* MIDDLE */
.ai-middle{width:200px;flex-shrink:0;background:rgba(0,3,10,.97);display:flex;flex-direction:column;align-items:center;overflow:hidden}
.ai-middle-top{width:100%;padding:12px 12px 7px;border-bottom:1px solid rgba(0,212,180,.08);display:flex;align-items:center;justify-content:space-between}
.ai-middle-top h3{color:rgba(0,212,180,.6);font-size:9px;letter-spacing:3px}
.ai-status-dot{width:7px;height:7px;border-radius:50%;background:#1a3a34;display:inline-block;animation:pulse 2s infinite;margin-right:5px}
.ai-status-dot.active{background:#00d4b4}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.ai-middle-body{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:10px 8px;gap:8px;overflow-y:auto;width:100%}
.ai-middle-body::-webkit-scrollbar{width:2px}
.ai-mini-cards{width:100%;display:flex;flex-direction:column;gap:5px}
.ai-mini-card{background:rgba(0,10,18,.9);border:1px solid rgba(0,212,180,.12);border-radius:3px;padding:7px 9px}
