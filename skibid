async function aiGenerateReminders(memberId){var m=FAM_MEMBERS.find(function(x){return x.id===memberId;});if(!m)return;showToast('🤖 AI đang tạo lịch nhắc...');var prompt='Tạo 3 lịch nhắc sức khoẻ cụ thể cho '+m.name+' ('+m.age+' tuổi, có: '+m.conditions.join(', ')+') theo format JSON array: [{"icon":"emoji","title":"tiêu đề ngắn","time":"HH:MM","note":"ghi chú chi tiết"}]. Chỉ trả về JSON, không thêm text.';try{var resp=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:400,messages:[{role:'user',content:prompt}]})});var data=await resp.json();var text=(data.content||[]).map(function(c){return c.text||'';}).join('').replace(/```json|```/g,'').trim();var newRems=JSON.parse(text);newRems.forEach(function(r,i){m.reminders.push({id:Date.now()+i,icon:r.icon||'💊',title:r.title,time:r.time||'09:00',note:r.note||'',done:false,urgent:false});});SFX.win();showToast('🤖 AI đã tạo '+newRems.length+' lịch nhắc mới!');renderReminders(m);renderFamilyMemberList();}catch(e){showToast('⚠ Không kết nối được AI, thử lại sau','red');}}
