/* CENTER: detail */
.fam-center{flex:1;display:flex;flex-direction:column;overflow:hidden}
.fam-center-top{padding:14px 18px 10px;border-bottom:1px solid rgba(255,150,200,.08);display:flex;align-items:center;gap:14px}
.fam-avatar{width:48px;height:48px;border-radius:50%;border:2px solid rgba(255,150,200,.3);background:rgba(255,150,200,.1);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.fam-avatar.age-child{border-color:rgba(100,200,255,.4);background:rgba(100,200,255,.08)}
.fam-avatar.age-elder{border-color:rgba(255,200,100,.4);background:rgba(255,200,100,.08)}
.fam-info h2{color:#ffb0d8;font-size:16px;font-weight:900;letter-spacing:2px}
.fam-info p{color:rgba(255,150,200,.4);font-size:9px;letter-spacing:2px;margin-top:2px}
.fam-center-scroll{flex:1;overflow-y:auto;padding:14px 18px;display:flex;flex-direction:column;gap:12px}
.fam-center-scroll::-webkit-scrollbar{width:3px}
.fam-center-scroll::-webkit-scrollbar-thumb{background:rgba(255,150,200,.15)}
/* Reminders */
.fam-section-label{color:rgba(255,150,200,.5);font-size:8px;letter-spacing:3px;margin-bottom:8px;padding-bottom:5px;border-bottom:1px solid rgba(255,150,200,.08)}
.reminder-card{background:rgba(20,8,28,.9);border:1px solid rgba(255,150,200,.15);border-radius:8px;padding:12px 14px;display:flex;align-items:flex-start;gap:10px;position:relative}
