.fam-body{flex:1;display:flex;overflow:hidden;gap:0}
/* LEFT: member list */
.fam-left{width:260px;flex-shrink:0;border-right:1px solid rgba(255,150,200,.1);display:flex;flex-direction:column;overflow:hidden}
