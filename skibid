var gameReminderTimer=null;
function scheduleGameReminders(){clearTimeout(gameReminderTimer);var pending=[];FAM_MEMBERS.forEach(function(m){m.reminders.forEach(function(r){if(!r.done&&r.urgent){pending.push({member:m,reminder:r});}});});if(pending.length>0){var item=pending[Math.floor(Math.random()*pending.length)];gameReminderTimer=setTimeout(function(){if(G.scr==='game'){var el=document.getElementById('gameReminder');el.innerHTML='💌 Nhắc gia đình: '+item.member.emoji+' <b>'+item.member.name+'</b> — '+item.reminder.title+' ('+item.reminder.time+') <span style="opacity:.6;font-size:9px">· Nhấn để đóng</span>';el.style.display='block';setTimeout(function(){el.style.display='none';},8000);}},45000+(Math.random()*60000));}}

