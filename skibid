function doOvertime(earn,fat,overnight,hours,hpLoss){closeM();G.workingAnim=true;G.workAnimTimer=40;hours=hours||3;var ti=setInterval(function(){if(G.workAnimTimer>0)SFX.typing();else clearInterval(ti);},200);setTimeout(function(){G.workingAnim=false;G.money+=earn;G.fatigue=Math.min(100,G.fatigue+fat);if(overnight||hpLoss){var loss=hpLoss||(hours<=4?10:hours<=7?25:40);G.hp=Math.max(1,G.hp-loss);}drainEnergy(hours,overnight?1.5:1);updateGameTime(hours);spawnP(G.p.x,G.p.y,'money');popText(G.p.x,G.p.y,'+'+fmt(earn));SFX.bigcoin();checkDanger();if(G.fatigue>=100)triggerDeath('exhaustion');else checkWin();},800);}
