.reminder-card .rc-icon{font-size:22px;flex-shrink:0}
.reminder-card .rc-body{flex:1}
.reminder-card .rc-title{font-size:13px;font-weight:bold;color:#fff;margin-bottom:3px}
.reminder-card .rc-time{font-size:10px;color:rgba(255,200,100,.7);margin-bottom:5px}
.reminder-card .rc-note{font-size:10px;color:rgba(200,180,200,.5);line-height:1.5}
.reminder-card .rc-send{position:absolute;top:10px;right:10px;background:linear-gradient(135deg,#5a1a40,#ff80b0);border:none;color:#fff;padding:5px 10px;font-size:9px;font-family:'Courier New',monospace;cursor:pointer;border-radius:4px;letter-spacing:1px;transition:all .2s}
.reminder-card .rc-send:hover{filter:brightness(1.2);transform:scale(1.05)}
